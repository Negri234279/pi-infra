# Grafana annotations for `run.sh` (option B). Copy to `.env.local` (gitignored)
# and fill in. Ansible runs on the rpi5 host, so Grafana is the published port.
#
#   cp .env.local.example .env.local

# Base Grafana URL (NOT the /api/annotations path). From the rpi5 host itself:
GRAFANA_URL=http://localhost:3000

# Auth — pick ONE. A Grafana service-account token (Editor role) is preferred over
# reusing the admin password. Create it in Grafana:
#   Administration → Service accounts → Add → role Editor → Add token.
GRAFANA_API_KEY=

# ...or, quick & dirty, reuse the admin credentials (same as GF_ADMIN_* in ../.env):
# GRAFANA_USER=admin
# GRAFANA_PASSWORD=changeme

# Grafana runs on plain HTTP on the LAN → cert validation off.
GRAFANA_VALIDATE_CERT=false

# Optional: pin the annotation to a specific dashboard/panel (numeric IDs).
# Leave unset to create org-wide annotations visible on every dashboard.
# GRAFANA_DASHBOARD_ID=
# GRAFANA_PANEL_IDS=
