# Central observability stack — copy to `.env` and adjust.
#   cp .env.example .env

# --- Grafana ---
# Initial admin credentials (change the password before exposing Grafana).
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=admin

# --- Prometheus (infra) retention ---
# Keep storage bounded so cAdvisor's high series count doesn't wear the Pi's
# disk. Whichever limit is hit first wins.
PROM_RETENTION_TIME=15d
PROM_RETENTION_SIZE=2GB

# --- NGINX Proxy Manager ---
# NPM runs in the core stack with embedded SQLite (no DB env needed). On first run,
# log in to the admin UI at http://<pi>:81 with the default credentials
#   admin@example.com / changeme
# NPM forces you to change them immediately. The proxy listens on :80 and :443.

# --- Shared Postgres ---
# One Postgres for every app. The superuser password protects the whole cluster;
# the provisioner uses it to create per-app roles/databases. The exporter role is
# least-privilege (pg_monitor); pgbouncer_auth backs PgBouncer's auth_query.
# Keep these alphanumeric (they're interpolated into SQL by the provisioner).
POSTGRES_SUPERUSER_PASSWORD=changeme_super
PG_EXPORTER_USER=postgres_exporter
PG_EXPORTER_PASSWORD=changeme_exporter
PGBOUNCER_AUTH_PASSWORD=changeme_pgbouncer

# --- Alerting (Discord) ---
# Discord channel webhook (Server Settings → Integrations → Webhooks → Copy URL).
# Read at startup by the alertmanager-init container into a secret file; never
# committed. Leave empty to disable Discord notifications.
DISCORD_WEBHOOK_URL=

# --- Cloudflare (analytics + R2) ---
# Powers the "Cloudflare · negri.es" dashboard via cloudflare-exporter (zone
# traffic, cache, security, R2) and the Infinity datasource (per-subdomain).
# Create a token at Cloudflare → My Profile → API Tokens → Create Token → Custom
# with these permissions:
#   • Zone   → Analytics          → Read   (HTTP traffic, cache, threats, countries)
#   • Zone   → Zone               → Read   (so the exporter can discover the zone)
#   • Account→ Account Analytics  → Read   (R2 storage + operations)
# Zone Resources: All zones (or just negri.es). Account Resources: your account.
CF_API_TOKEN=
# Account ID — Cloudflare dashboard → any domain → Overview → right sidebar
# ("Account ID"). NOT the token id. Required for account-scoped tokens and R2.
CF_ACCOUNT_ID=
# Optional: pin the exporter to one zone id (negri.es → Overview → API → Zone ID).
# Leave empty to auto-discover every zone the token can read. Also set this as the
# `cf_zone_tag` variable on the dashboard for the per-subdomain panel.
CF_ZONE_ID=
# negri.es on the free plan → keep true (only requests free-plan datasets). Set to
# false only if the zone is on a paid Cloudflare plan.
CF_FREE_TIER=true

# --- Remote access (wg-easy WireGuard VPN) ---
# One encrypted way in for a GitHub Actions runner or your own devices WITHOUT
# publishing any service: only UDP 51820 is exposed. Admin UI: http://192.168.1.7:51821
# (INIT_* apply on first boot only — manage clients from the UI afterwards).
#
# WG_HOST = the address CLIENTS dial. LAN-only devices can use the Pi's IP; a GitHub
# Action over the internet needs a PUBLIC IP or DDNS hostname here + a router rule
# forwarding UDP 51820 → 192.168.1.7. WireGuard is the only thing internet-facing.
WG_HOST=192.168.1.7
# Admin UI credentials (set a long password — v15 does NOT enforce complexity).
WG_ADMIN_USERNAME=admin
WG_ADMIN_PASSWORD=changeme_wg
# WireGuard UDP listen port (must match the router port-forward if remote).
WG_PORT=51820
# DNS pushed to clients while connected.
WG_DNS=1.1.1.1
# What clients route through the tunnel: VPN subnet + the Pi's LAN, so a connected
# runner/device can reach 192.168.1.7 and the rest of the home network. Trim to just
# the VPN subnet (10.8.0.0/24) if you only want to reach the Pi itself.
WG_ALLOWED_IPS=10.8.0.0/24,192.168.1.0/24

# --- Docker notifier app ---
DN_DISCORD_WEBHOOK_URL=
