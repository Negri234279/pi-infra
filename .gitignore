# Local env (secrets / per-host config)
.env
# Per-app secrets (each app ships a *.env.example; the real *.env stays local).
# Covers apps/<app>/*.env and nested ones like apps/<app>/postgres/provision.env.
apps/**/*.env
# Per-host secrets (each host dir ships a *.env.example; the real *.env stays local).
hosts/**/*.env
# Ansible run.sh Grafana-annotation creds (ships .env.local.example; real one local).
ansible/.env.local
# Uptime Kuma runtime data on the rpi3 (SQLite DB + monitors) — generated, never commit.
hosts/rpi3/data/

# NGINX Proxy Manager runtime data + certs (generated by the container, never commit).
core/nginx-proxy-manager/data/
core/nginx-proxy-manager/letsencrypt/

# Dashboards fetched by scripts/fetch-dashboards.sh are provisioned at runtime;
# uncomment to keep them out of git and rely on the fetch script instead.
# core/grafana/dashboards/*.json

secrets/
!secrets/.gitkeep

# mktxp device inventory holds the RouterOS API password — keep the real file
# local; only mktxp.conf.example (and the secret-free _mktxp.conf) are committed.
core/mktxp/mktxp.conf
# pve-exporter config holds the Proxmox API token. The live file now lives INSIDE the
# pve-exporter LXC (/etc/prometheus/pve.yml), not here — but keep this ignore so a
# leftover hub file from the old Docker setup can never be committed. Only
# pve.yml.example is tracked (it's the reference format for the in-LXC config).
core/pve-exporter/pve.yml
# ipmi_exporter config holds the NAS BMC's IPMI credentials — keep the real file
# local; only ipmi.yml.example is committed (the reference format).
core/ipmi-exporter/ipmi.yml
# Artifacts written by the truenas_disk_inventory role on the hub (generated chassis map +
# JSON inventory). They are advisory output ONLY — you paste the relabel block into the
# committed prometheus.yml by hand and commit that. Never track the generated copies, or the
# git-pull deploy would conflict with a machine-written file.
core/prometheus/generated/
# Local-only compose override (e.g. skip node-exporter on Docker Desktop).
core/homepage/config
!core/homepage/config/*.yaml

.mcp.json

# Ansible: retry files, downloaded Galaxy collections, and any Vault password file.
ansible/*.retry
ansible/**/*.retry
ansible/collections/
ansible/.vault_pass

# Python bytecode cache (e.g. from running/compiling the role helper scripts locally).
__pycache__/
*.pyc