        {
            "type": "stat",
            "title": "Estado actual",
            "description": "blackbox probe_success per target (app /api/healthz, obs readiness). UP means the real HTTP path responded 2xx.",
            "gridPos": { "h": 7, "w": 4, "x": 0, "y": 64 },
            "datasource": { "type": "prometheus", "uid": "prometheus-coreforge" },
            "targets": [
                { "refId": "A", "expr": "probe_success", "legendFormat": "{{name}}" }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "none",
                    "color": { "mode": "thresholds" },
                    "mappings": [
                        {
                            "type": "value",
                            "options": {
                                "0": { "text": "DOWN", "color": "red" },
                                "1": { "text": "UP", "color": "green" }
                            }
                        }
                    ],
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            { "color": "red", "value": null },
                            { "color": "green", "value": 1 }
                        ]
                    }
                },
                "overrides": []
            },
            "options": {
                "graphMode": "none",
                "colorMode": "background",
                "textMode": "value_and_name",
                "reduceOptions": { "calcs": ["lastNotNull"] }
            }
        },
