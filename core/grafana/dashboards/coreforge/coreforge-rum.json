{
    "uid": "coreforge-rum",
    "title": "CoreForge · Browser RUM",
    "tags": ["coreforge", "rum", "faro"],
    "schemaVersion": 39,
    "editable": true,
    "timezone": "browser",
    "refresh": "1m",
    "time": { "from": "now-24h", "to": "now" },
    "templating": { "list": [] },
    "annotations": { "list": [] },
    "links": [
        {
            "title": "CoreForge · Overview",
            "type": "link",
            "icon": "dashboard",
            "url": "/d/coreforge-overview",
            "targetBlank": false
        }
    ],
    "panels": [
        {
            "type": "row",
            "title": "Core Web Vitals · p75 (real users)",
            "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
            "collapsed": false,
            "panels": []
        },
        {
            "type": "stat",
            "title": "LCP p75",
            "description": "Largest Contentful Paint, 75th percentile across real browser sessions. Good < 2.5s, poor > 4s.",
            "gridPos": { "h": 5, "w": 4, "x": 0, "y": 1 },
            "datasource": { "type": "loki", "uid": "loki-coreforge" },
            "targets": [
                {
                    "refId": "A",
                    "queryType": "instant",
                    "expr": "quantile_over_time(0.75, {job=\"faro\", kind=\"measurement\"} | logfmt | type=\"web-vitals\" | unwrap value_lcp | __error__=\"\" [$__range])"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "ms",
                    "color": { "mode": "thresholds" },
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            { "color": "green", "value": null },
                            { "color": "orange", "value": 2500 },
                            { "color": "red", "value": 4000 }
                        ]
                    }
                },
                "overrides": []
            },
            "options": {
                "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
                "colorMode": "value",
                "graphMode": "area",
                "textMode": "value"
            }
        },
        {
            "type": "stat",
            "title": "INP p75",
            "description": "Interaction to Next Paint, p75. Good < 200ms, poor > 500ms.",
            "gridPos": { "h": 5, "w": 4, "x": 4, "y": 1 },
            "datasource": { "type": "loki", "uid": "loki-coreforge" },
            "targets": [
                {
                    "refId": "A",
                    "queryType": "instant",
                    "expr": "quantile_over_time(0.75, {job=\"faro\", kind=\"measurement\"} | logfmt | type=\"web-vitals\" | unwrap value_inp | __error__=\"\" [$__range])"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "ms",
                    "color": { "mode": "thresholds" },
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            { "color": "green", "value": null },
                            { "color": "orange", "value": 200 },
                            { "color": "red", "value": 500 }
                        ]
                    }
                },
                "overrides": []
            },
            "options": {
                "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
                "colorMode": "value",
                "graphMode": "area",
                "textMode": "value"
            }
        },
