        {
            "type": "row",
            "title": "Web Vitals over time",
            "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 },
            "collapsed": false,
            "panels": []
        },
        {
            "type": "timeseries",
            "title": "Web vitals p75 over time",
            "gridPos": { "h": 8, "w": 12, "x": 0, "y": 7 },
            "datasource": { "type": "loki", "uid": "loki-coreforge" },
            "targets": [
                {
                    "refId": "A",
                    "expr": "quantile_over_time(0.75, {job=\"faro\", kind=\"measurement\"} | logfmt | type=\"web-vitals\" | unwrap value_lcp | __error__=\"\" [$__auto]) by ()",
                    "legendFormat": "LCP"
                },
                {
                    "refId": "B",
                    "expr": "quantile_over_time(0.75, {job=\"faro\", kind=\"measurement\"} | logfmt | type=\"web-vitals\" | unwrap value_fcp | __error__=\"\" [$__auto]) by ()",
                    "legendFormat": "FCP"
                },
                {
                    "refId": "C",
                    "expr": "quantile_over_time(0.75, {job=\"faro\", kind=\"measurement\"} | logfmt | type=\"web-vitals\" | unwrap value_ttfb | __error__=\"\" [$__auto]) by ()",
                    "legendFormat": "TTFB"
                },
                {
                    "refId": "D",
                    "expr": "quantile_over_time(0.75, {job=\"faro\", kind=\"measurement\"} | logfmt | type=\"web-vitals\" | unwrap value_inp | __error__=\"\" [$__auto]) by ()",
                    "legendFormat": "INP"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "ms",
                    "custom": { "fillOpacity": 8, "lineWidth": 2, "showPoints": "never" },
                    "color": { "mode": "palette-classic" }
                },
                "overrides": []
            },
            "options": {
                "legend": { "displayMode": "list", "placement": "bottom" },
                "tooltip": { "mode": "multi", "sort": "desc" }
            }
        },
        {
            "type": "timeseries",
            "title": "CLS p75 over time",
            "gridPos": { "h": 8, "w": 6, "x": 12, "y": 7 },
            "datasource": { "type": "loki", "uid": "loki-coreforge" },
            "targets": [
                {
                    "refId": "A",
                    "expr": "quantile_over_time(0.75, {job=\"faro\", kind=\"measurement\"} | logfmt | type=\"web-vitals\" | unwrap value_cls | __error__=\"\" [$__auto]) by ()",
                    "legendFormat": "CLS"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "none",
                    "decimals": 3,
                    "custom": { "fillOpacity": 8, "lineWidth": 2, "showPoints": "never" },
