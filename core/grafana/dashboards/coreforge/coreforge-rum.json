        {
            "type": "row",
            "title": "Frontend errors",
            "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
            "collapsed": false,
            "panels": []
        },
        {
            "type": "timeseries",
            "title": "Frontend errors (rate)",
            "description": "Unhandled errors, promise rejections and console.error captured by Faro (kind=exception).",
            "gridPos": { "h": 8, "w": 8, "x": 0, "y": 24 },
            "datasource": { "type": "loki", "uid": "loki-coreforge" },
            "targets": [
                {
                    "refId": "A",
                    "expr": "sum(count_over_time({job=\"faro\", kind=\"exception\"} [$__auto]))",
                    "legendFormat": "exceptions"
