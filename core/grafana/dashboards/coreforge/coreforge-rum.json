            },
            "options": { "showHeader": true, "sortBy": [{ "displayName": "count", "desc": true }] }
        },
        {
            "type": "row",
            "title": "Fetch / XHR (→ Tempo traces)",
            "gridPos": { "h": 1, "w": 24, "x": 0, "y": 50 },
            "collapsed": false,
            "panels": []
        },
        {
            "type": "timeseries",
            "title": "Fetch duration p95 (ms)",
            "description": "faro.tracing.fetch → event_data_duration_ns (converted to ms). Each is also a span in Tempo with W3C trace propagation to the backend.",
            "gridPos": { "h": 7, "w": 12, "x": 0, "y": 51 },
            "datasource": { "type": "loki", "uid": "loki-coreforge" },
            "targets": [
                {
                    "refId": "A",
                    "expr": "quantile_over_time(0.95, {job=\"faro\", kind=\"event\"} | logfmt | event_name=\"faro.tracing.fetch\" | unwrap event_data_duration_ns | __error__=\"\" [$__auto]) by () / 1e6",
                    "legendFormat": "fetch p95"
                }
            ],
            "fieldConfig": {
