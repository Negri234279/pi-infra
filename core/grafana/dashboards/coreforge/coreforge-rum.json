        {
            "type": "row",
            "title": "Client events (buttons & flows)",
            "gridPos": { "h": 1, "w": 24, "x": 0, "y": 41 },
            "collapsed": false,
            "panels": []
        },
        {
            "type": "timeseries",
            "title": "Business / UI events by name",
            "description": "Faro pushEvent from islands & inline scripts (trackEvent / __cfTrack): landing_google_cta, filter_export_json, filter_clone, opencore_clone, category_clone, org_delete, org_kick, plus any ui_* events. Auto faro.* instrumentation events are excluded.",
            "gridPos": { "h": 8, "w": 12, "x": 0, "y": 42 },
            "datasource": { "type": "loki", "uid": "loki-coreforge" },
            "targets": [
                {
                    "refId": "A",
                    "expr": "sum by (event_name) (count_over_time({job=\"faro\", kind=\"event\"} | logfmt | event_name!~\"faro\\\\..+\" | event_name!~\"session_.+\" [$__auto]))",
                    "legendFormat": "{{event_name}}"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "none",
                    "custom": { "fillOpacity": 25, "lineWidth": 1, "showPoints": "never", "stacking": { "mode": "normal" }, "drawStyle": "bars" },
                    "color": { "mode": "palette-classic" }
                },
                "overrides": []
            },
            "options": {
                "legend": { "displayMode": "list", "placement": "bottom" },
                "tooltip": { "mode": "multi", "sort": "desc" }
            }
        },
