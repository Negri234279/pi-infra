            "targets": [
                {
                    "refId": "A",
                    "queryType": "instant",
                    "expr": "sum by (event_name) (count_over_time({job=\"faro\", kind=\"event\"} | logfmt | event_name!~\"faro\\\\..+\" | event_name!~\"session_.+\" [$__range]))",
                    "legendFormat": "{{event_name}}"
                }
