            },
            "options": {
                "legend": { "displayMode": "hidden", "placement": "bottom" },
                "tooltip": { "mode": "single" }
            }
        },
        {
            "type": "table",
            "title": "Top error messages",
            "description": "Most frequent exception messages in range.",
            "gridPos": { "h": 8, "w": 16, "x": 8, "y": 24 },
            "datasource": { "type": "loki", "uid": "loki-coreforge" },
            "targets": [
                {
                    "refId": "A",
                    "queryType": "instant",
                    "expr": "topk(10, sum by (value) (count_over_time({job=\"faro\", kind=\"exception\"} | logfmt | value!=\"\" [$__range])))",
                    "legendFormat": "{{value}}"
                }
            ],
            "fieldConfig": {
                "defaults": { "unit": "none", "custom": { "align": "left" } },
                "overrides": [
                    { "matcher": { "id": "byName", "options": "Value #A" }, "properties": [{ "id": "custom.width", "value": 90 }, { "id": "displayName", "value": "count" }] }
                ]
            },
            "options": { "showHeader": true, "sortBy": [{ "displayName": "count", "desc": true }] }
        },
