      "description": "Solo sensores cuyo estado reportado por el BMC no es nominal (1 = warning, 2 = critical). Vacío = todo nominal.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "WARNING",
                  "color": "yellow"
                },
                "2": {
                  "text": "CRITICAL",
                  "color": "red"
                }
              }
            }
          ]
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Estado"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "custom.width",
                "value": 130
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Estado",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "id": true,
              "instance": true,
              "job": true
            },
            "renameByName": {
              "__name__": "Métrica",
              "name": "Sensor",
              "type": "Tipo",
              "Value": "Estado"
            }
          }
        }
      ],
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-infra"
          },
          "expr": "{__name__=~\"ipmi_(temperature|fan_speed|voltage|sensor)_state\", job=\"ipmi\"} > 0",
          "instant": true,
          "format": "table"
        }
      ]
    }
  ]
}
