    {
      "id": 12,
      "type": "state-timeline",
      "title": "Run outcomes over time (last 100) · $repo",
      "description": "Each recent run placed on a timeline by start time and coloured by conclusion — the cadence and health of the pipeline at a glance.",
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "github-rest" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 27 },
      "options": { "showValue": "never", "rowHeight": 0.9, "mergeValues": false, "alignValue": "center", "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 80, "lineWidth": 0 },
          "mappings": [
            { "type": "value", "options": { "success": { "color": "green", "index": 0 }, "failure": { "color": "red", "index": 1 }, "cancelled": { "color": "dark-yellow", "index": 2 }, "skipped": { "color": "text", "index": 3 }, "timed_out": { "color": "red", "index": 4 }, "startup_failure": { "color": "red", "index": 5 } } },
            { "type": "special", "options": { "match": "null", "result": { "text": "running", "color": "yellow", "index": 6 } } }
          ],
          "color": { "mode": "fixed", "fixedColor": "green" }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A", "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "github-rest" },
          "type": "json", "source": "url", "format": "table", "parser": "backend",
          "url": "https://api.github.com/repos/$owner/$repo/actions/runs",
          "url_options": { "method": "GET", "headers": [ { "key": "Accept", "value": "application/vnd.github+json" } ], "params": [ { "key": "per_page", "value": "100" } ] },
          "root_selector": "workflow_runs",
          "columns": [
            { "selector": "run_started_at", "text": "Time", "type": "timestamp" },
            { "selector": "conclusion", "text": "Outcome", "type": "string" }
          ]
        }
      ]
    },

    { "id": 13, "type": "row", "title": "Repository context · $repo", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 35 } },

    {
      "id": 14,
      "type": "table",
      "title": "Open pull requests",
