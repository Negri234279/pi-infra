          "url": "https://api.github.com/repos/$owner/$repo/actions/runs",
          "url_options": { "method": "GET", "headers": [ { "key": "Accept", "value": "application/vnd.github+json" } ], "params": [ { "key": "per_page", "value": "1" }, { "key": "status", "value": "cancelled" }, { "key": "created", "value": ">=${__from:date:YYYY-MM-DD}" } ] },
          "root_selector": "",
          "columns": [ { "selector": "total_count", "text": "Cancelled", "type": "number" } ]
