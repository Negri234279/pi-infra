          "root_selector": "workflow_runs",
          "columns": [
            { "selector": "name", "text": "Workflow", "type": "string" },
            { "selector": "display_title", "text": "Title", "type": "string" },
            { "selector": "head_branch", "text": "Branch", "type": "string" },
            { "selector": "status", "text": "Status", "type": "string" },
            { "selector": "run_started_at", "text": "Started", "type": "timestamp" },
            { "selector": "actor.login", "text": "Actor", "type": "string" },
            { "selector": "html_url", "text": "URL", "type": "string" }
          ]
        }
      ]
    },
    {
      "id": 11,
      "type": "bargauge",
      "title": "Runs by outcome (range) · $repo",
      "description": "Count of runs per outcome within the dashboard time range.",
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "github-rest" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "palette-classic" } }, "overrides": [
        { "matcher": { "id": "byName", "options": "Success" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } } ] },
        { "matcher": { "id": "byName", "options": "Failed" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] },
