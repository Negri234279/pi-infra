{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "tags": ["ci-cd", "github", "docker"],
  "title": "CI/CD · GitHub + Docker Hub",
  "uid": "ci-cd-github",
  "timezone": "browser",
  "time": { "from": "now-30d", "to": "now" },
  "refresh": "5m",
  "templating": {
    "list": [
      {
        "name": "owner",
        "label": "GitHub owner",
        "description": "GitHub user/org that owns the repos.",
        "type": "textbox",
        "query": "Negri234279",
        "current": { "text": "Negri234279", "value": "Negri234279" }
      },
      {
        "name": "repo",
        "label": "Repository",
        "description": "Repo whose CI/CD is shown. Edit this list to add/remove repos.",
        "type": "custom",
        "query": "pi-infra,coreforge,powerlog,proxy-control,wake-lan-app,docker-notifier",
        "current": { "text": "pi-infra", "value": "pi-infra" },
        "options": [
          { "text": "pi-infra", "value": "pi-infra", "selected": true },
          { "text": "coreforge", "value": "coreforge", "selected": false },
          { "text": "powerlog", "value": "powerlog", "selected": false },
          { "text": "proxy-control", "value": "proxy-control", "selected": false },
          { "text": "wake-lan-app", "value": "wake-lan-app", "selected": false },
          { "text": "docker-notifier", "value": "docker-notifier", "selected": false }
        ]
      },
      {
        "name": "dh_namespace",
        "label": "Docker Hub user",
        "description": "Docker Hub namespace/user for the image panels.",
        "type": "textbox",
        "query": "negrii",
        "current": { "text": "negrii", "value": "negrii" }
      },
      {
        "name": "dh_image",
        "label": "Docker Hub image",
        "description": "Image whose tag/build history is shown.",
        "type": "custom",
        "query": "docker-notifier,coreforge-conveyor-filters,powerlog-api,powerlog-web,proxy-control,wake-lan-app",
        "current": { "text": "docker-notifier", "value": "docker-notifier" },
        "options": [
          { "text": "docker-notifier", "value": "docker-notifier", "selected": true },
          { "text": "coreforge-conveyor-filters", "value": "coreforge-conveyor-filters", "selected": false },
          { "text": "powerlog-api", "value": "powerlog-api", "selected": false },
          { "text": "powerlog-web", "value": "powerlog-web", "selected": false },
          { "text": "proxy-control", "value": "proxy-control", "selected": false },
          { "text": "wake-lan-app", "value": "wake-lan-app", "selected": false }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "gridPos": { "h": 3, "w": 24, "x": 0, "y": 0 },
      "options": {
        "mode": "markdown",
        "content": "**CI/CD for `$owner/$repo`.** GitHub **Actions** panels (KPIs, latest runs, in-progress, outcome timeline) query the **GitHub REST API** live via Infinity (`/actions/runs` — every workflow in one call). **Repo context** (PRs, commits, releases, workflows) uses the **official GitHub datasource**. **Docker Hub** panels query Docker Hub's public API (image publish times + per-tag build history). GitHub needs a read-only PAT in `$GITHUB_TOKEN`; Docker Hub needs none. KPIs are bound to the dashboard time range (`created >= from`)."
      }
    },

    { "id": 2, "type": "row", "title": "GitHub Actions · $repo", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 3 } },

    {
      "id": 3,
      "type": "stat",
      "title": "Total runs",
      "description": "Workflow runs created within the dashboard time range.",
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "github-rest" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "blue" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "" }, "colorMode": "value", "graphMode": "none", "textMode": "value" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "github-rest" },
          "type": "json", "source": "url", "format": "table", "parser": "backend",
          "url": "https://api.github.com/repos/$owner/$repo/actions/runs",
          "url_options": { "method": "GET", "headers": [ { "key": "Accept", "value": "application/vnd.github+json" } ], "params": [ { "key": "per_page", "value": "1" }, { "key": "created", "value": ">=${__from:date:YYYY-MM-DD}" } ] },
          "root_selector": "",
          "columns": [ { "selector": "total_count", "text": "Total", "type": "number" } ]
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Success",
      "description": "Runs that completed successfully in range.",
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "github-rest" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "green" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "" }, "colorMode": "value", "graphMode": "none", "textMode": "value" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "github-rest" },
          "type": "json", "source": "url", "format": "table", "parser": "backend",
          "url": "https://api.github.com/repos/$owner/$repo/actions/runs",
          "url_options": { "method": "GET", "headers": [ { "key": "Accept", "value": "application/vnd.github+json" } ], "params": [ { "key": "per_page", "value": "1" }, { "key": "status", "value": "success" }, { "key": "created", "value": ">=${__from:date:YYYY-MM-DD}" } ] },
          "root_selector": "",
          "columns": [ { "selector": "total_count", "text": "Success", "type": "number" } ]
        }
