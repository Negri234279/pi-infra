    {
      "id": 9,
      "type": "table",
      "title": "Latest runs · $repo",
      "description": "The 30 most recent workflow runs across ALL workflows. Which workflow, branch, event, actor, live status and final conclusion. Click the title to open the run on GitHub.",
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "github-rest" },
      "gridPos": { "h": 11, "w": 24, "x": 0, "y": 8 },
      "options": { "showHeader": true, "cellHeight": "sm" },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "filterable": true } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Title" },
            "properties": [
              { "id": "links", "value": [ { "title": "Open run on GitHub", "url": "${__data.fields.URL}", "targetBlank": true } ] }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Conclusion" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-text" } },
              { "id": "mappings", "value": [
                { "type": "value", "options": { "success": { "color": "green", "index": 0 }, "failure": { "color": "red", "index": 1 }, "cancelled": { "color": "text", "index": 2 }, "skipped": { "color": "text", "index": 3 }, "timed_out": { "color": "red", "index": 4 }, "startup_failure": { "color": "red", "index": 5 }, "action_required": { "color": "orange", "index": 6 } } },
                { "type": "special", "options": { "match": "null", "result": { "text": "running", "color": "yellow", "index": 7 } } }
              ] }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Status" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-text" } },
              { "id": "mappings", "value": [
                { "type": "value", "options": { "completed": { "color": "text", "index": 0 }, "in_progress": { "color": "yellow", "index": 1 }, "queued": { "color": "orange", "index": 2 }, "waiting": { "color": "orange", "index": 3 }, "requested": { "color": "orange", "index": 4 } } }
              ] }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "URL" },
            "properties": [ { "id": "custom.hidden", "value": true } ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "github-rest" },
          "type": "json", "source": "url", "format": "table", "parser": "backend",
          "url": "https://api.github.com/repos/$owner/$repo/actions/runs",
          "url_options": { "method": "GET", "headers": [ { "key": "Accept", "value": "application/vnd.github+json" } ], "params": [ { "key": "per_page", "value": "30" } ] },
          "root_selector": "workflow_runs",
          "columns": [
            { "selector": "run_number", "text": "#", "type": "number" },
            { "selector": "name", "text": "Workflow", "type": "string" },
            { "selector": "display_title", "text": "Title", "type": "string" },
            { "selector": "event", "text": "Event", "type": "string" },
            { "selector": "head_branch", "text": "Branch", "type": "string" },
            { "selector": "status", "text": "Status", "type": "string" },
            { "selector": "conclusion", "text": "Conclusion", "type": "string" },
            { "selector": "actor.login", "text": "Actor", "type": "string" },
            { "selector": "run_started_at", "text": "Started", "type": "timestamp" },
            { "selector": "updated_at", "text": "Updated", "type": "timestamp" },
            { "selector": "html_url", "text": "URL", "type": "string" }
          ]
        }
      ]
    },

    {
      "id": 10,
      "type": "table",
      "title": "Running / queued now · $repo",
      "description": "Runs currently in progress or queued — what is executing right now and since when. GitHub does not expose a percentage; 'Started' shows how long it has been running.",
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "github-rest" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 },
      "options": { "showHeader": true, "cellHeight": "sm" },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "filterable": true } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Title" },
