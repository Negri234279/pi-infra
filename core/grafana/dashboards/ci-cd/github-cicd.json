          },
          { "matcher": { "id": "byName", "options": "URL" }, "properties": [ { "id": "custom.hidden", "value": true } ] }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "github-rest" },
          "type": "json", "source": "url", "format": "table", "parser": "backend",
          "url": "https://api.github.com/repos/$owner/$repo/actions/runs",
          "url_options": { "method": "GET", "headers": [ { "key": "Accept", "value": "application/vnd.github+json" } ], "params": [ { "key": "per_page", "value": "15" }, { "key": "status", "value": "in_progress" } ] },
          "root_selector": "workflow_runs",
          "columns": [
            { "selector": "name", "text": "Workflow", "type": "string" },
            { "selector": "display_title", "text": "Title", "type": "string" },
            { "selector": "head_branch", "text": "Branch", "type": "string" },
