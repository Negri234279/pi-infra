    {
      "datasource": { "type": "prometheus", "uid": "prometheus-infra" },
      "description": "Scrape health of every media exporter + Jellyfin's /metrics.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red", "index": 1 }, "1": { "text": "UP", "color": "green", "index": 0 } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 10, "x": 0, "y": 1 },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name",
        "wideLayout": true
      },
      "pluginVersion": "11.1.4",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-infra" },
          "editorMode": "code",
          "expr": "up{job=~\"sonarr|radarr|bazarr|qbittorrent|gluetun|jellyfin\"}",
          "instant": true,
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ],
      "title": "Servicios",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-infra" },
      "description": "gluetun VPN tunnel status (kill-switch protects qBittorrent). Smoothed with max_over_time[3m] to ignore the exporter's transient 0s (a failed port-forward fetch wrongly zeroes the status); a real outage stays 0 for minutes and still shows CAÍDA.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            { "type": "value", "options": { "0": { "text": "CAÍDA", "color": "red", "index": 1 }, "1": { "text": "CONECTADO", "color": "green", "index": 0 } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 4, "x": 10, "y": 1 },
      "id": 3,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value",
        "wideLayout": true
      },
      "pluginVersion": "11.1.4",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-infra" },
          "editorMode": "code",
          "expr": "max_over_time(gluetun_vpn_status[3m])",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "VPN",
      "type": "stat"
    },
