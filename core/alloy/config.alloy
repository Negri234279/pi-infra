// Core Alloy — ships logs to the core Loki from three sources:
//   1. the Pi's own systemd journal (host logs),
//   2. every Docker container on the Pi,
//   3. the MikroTik router's REMOTE SYSLOG (RFC3164 on udp/tcp 514).
// RouterOS sends BSD-syslog to the Pi on 514 (see core/network/README.md for the
// router-side `/system logging` commands). SwOS switches can't do remote logging,
// so the switch is not represented here.

// ── Host journald ──────────────────────────────────────────────────────────
// Reads the persistent journal at /var/log/journal (enabled 2026-08-06). After a
// hang + reboot, the previous boot's last lines get shipped here and become
// queryable in Grafana, and the host-log alert rules (core/loki/rules) can fire
// on kernel/NVMe errors. Only bounded labels are promoted to keep cardinality low.
loki.source.journal "host" {
	path          = "/var/log/journal"
	max_age       = "24h"
	labels        = { job = "systemd-journal", host = "rpi5" }
	relabel_rules = loki.relabel.journal.rules
	forward_to    = [loki.write.default.receiver]
}

loki.relabel "journal" {
	forward_to = [] // consumed only for its exported `.rules`
	rule {
		source_labels = ["__journal__systemd_unit"]
		target_label  = "unit"
	}
	rule {
		source_labels = ["__journal_priority_keyword"]
		target_label  = "severity"
	}
}

// ── Docker container logs ──────────────────────────────────────────────────
// Discovers every container over the socket and tails its stdout/stderr. The
// container name (minus the leading slash) becomes the `container` label.
discovery.docker "containers" {
	host = "unix:///var/run/docker.sock"
}

loki.source.docker "containers" {
	host          = "unix:///var/run/docker.sock"
	targets       = discovery.docker.containers.targets
	labels        = { job = "docker", host = "rpi5" }
	relabel_rules = loki.relabel.docker.rules
	forward_to    = [loki.write.default.receiver]
}

loki.relabel "docker" {
	forward_to = [] // consumed only for its exported `.rules`
	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/(.*)"
		target_label  = "container"
	}
}

// ── MikroTik router remote syslog ──────────────────────────────────────────
loki.source.syslog "network" {
	// UDP is what RouterOS `remote` logging uses by default.
	listener {
		address       = "0.0.0.0:514"
		protocol      = "udp"
		syslog_format = "rfc3164"
		labels        = { job = "syslog", source = "router" }
	}
	// TCP too, in case you switch the router to remote-protocol=tcp.
	listener {
		address       = "0.0.0.0:514"
		protocol      = "tcp"
		syslog_format = "rfc3164"
		labels        = { job = "syslog", source = "router" }
	}
	forward_to = [loki.relabel.network.receiver]
}

// The syslog parser exposes the message metadata as internal __syslog_* labels;
// promote the two useful ones to real labels (kept bounded), and drop the rest.
// Everything else stays in the log body, queried with LogQL line filters.
loki.relabel "network" {
	forward_to = [loki.write.default.receiver]

	rule {
		source_labels = ["__syslog_message_hostname"]
		target_label  = "hostname"
	}
	rule {
		source_labels = ["__syslog_message_severity"]
		target_label  = "severity"
	}
}

loki.write "default" {
	endpoint {
		url = "http://loki:3100/loki/api/v1/push"
	}
}
