# hosts/g8 — cold-storage config templates. These are HOST-LOCAL files, NOT read
# by docker compose and NOT committed (they hold the restic password + iLO creds).
# Copy each block to the box that uses it, under /etc/pi-backup/, chmod 0600.
#
#   G8:    /etc/pi-backup/backup.env   + /etc/pi-backup/restic-password
#   rpi5:  /etc/pi-backup/wake.env
#   Pis:   /etc/pi-backup/prepare.env  (one per source host, see per-host examples)

# ============================================================================
# [G8]  /etc/pi-backup/backup.env    — read by hosts/g8/backup.sh
# ============================================================================
# Source hosts to pull, "name=ip" space-separated. name = subdir in the repo.
SOURCES="rpi5=192.168.1.7 rpi3=192.168.1.6"
SSH_USER=backup                       # unprivileged user on each Pi (sudo prepare-backup.sh)
LANDING_DIR=/srv/backup/landing       # local rsync target (on the ZFS pool)
RESTIC_REPOSITORY=/srv/backup/repo    # restic repo (on the ZFS pool)
RESTIC_PASSWORD_FILE=/etc/pi-backup/restic-password
STAGING_DIR=/var/backups/staging      # path ON each source host (prepare.sh output)
KEEP_DAILY=7
KEEP_WEEKLY=4
KEEP_MONTHLY=6
# Reuse healthchecks.io (same account as the rpi5-watcher). New check: period 1d,
# grace a few h. The script pings /start, then success or /fail.
HC_URL=https://hc-ping.com/REPLACE-WITH-UUID
# KEEP_ON=1                           # debug: don't poweroff after the backup
# RESTIC_CHECK_READ_DATA=1            # full data verify (slow) — schedule monthly

# Offsite copy to Cloudflare R2 (disabled for now — uncomment block in backup.sh):
# R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# R2_BUCKET=pi-cold-backup
# R2_ACCESS_KEY=...
# R2_SECRET_KEY=...

# ============================================================================
# [rpi5]  /etc/pi-backup/wake.env    — read by scripts/wake-g8.sh
# ============================================================================
ILO_HOST=192.168.1.20                 # iLO 4 address (primary power-on path)
ILO_USER=backup-wake
ILO_PASSWORD=REPLACE-ME
G8_MAC=aa:bb:cc:dd:ee:ff              # NIC MAC for WOL fallback
G8_HOST=192.168.1.21                  # G8 LAN IP, polled for SSH readiness
WAIT_SECONDS=240

# ============================================================================
# [rpi5]  /etc/pi-backup/prepare.env — read by scripts/prepare-backup.sh
# ----------------------------------------------------------------------------
# What the rpi5 holds. Postgres is dumped logically; NPM/grafana/wg-easy/wake-lan
# are SQLite or file volumes. Adjust names/paths to your actual volume mounts
# (`docker volume inspect <vol>` → Mountpoint).
# ============================================================================
# PG_CONTAINER=postgres
# PG_SUPERUSER=postgres
# SQLITE_VOLUMES="npm:/var/lib/docker/volumes/core_npm-data/_data/database.sqlite wgeasy:/var/lib/docker/volumes/core_wg-easy/_data/wg0.json"
# STOP_COPY_VOLUMES="grafana:/var/lib/docker/volumes/core_grafana-data/_data|grafana"
# FILE_VOLUMES="prometheus:/var/lib/docker/volumes/core_prometheus-data/_data"

# ============================================================================
# [rpi3]  /etc/pi-backup/prepare.env — read by scripts/prepare-backup.sh
# ============================================================================
# SQLITE_VOLUMES="uptimekuma:/home/negri/pi-infra/hosts/rpi3/data/kuma.db"
