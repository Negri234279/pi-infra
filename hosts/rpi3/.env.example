# Copy to `.env` (stays local, gitignored). Consumed by hosts/rpi3/docker-compose.yml
# when deployed via `scripts/deploy-host.sh rpi3`.

# healthchecks.io ping URL for the rpi5 watcher (a NEW check, separate from the
# rpi5 dead-man). Create a check (period 2m, grace 5m) and paste its ping URL.
# Leave empty to disable the watcher (it idles).
RPI5_WATCH_HC_URL=
