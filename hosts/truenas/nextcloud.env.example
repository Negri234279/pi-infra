# Nextcloud secrets + settings for hosts/truenas/nextcloud.compose.yml.
# Copy to nextcloud.env (gitignored via `hosts/**/*.env`) and fill in. The truenas_nextcloud role
# syncs the real file to the NAS as `.env` next to the compose, where docker compose auto-reads it.
#
#   cp hosts/truenas/nextcloud.env.example hosts/truenas/nextcloud.env
#   # then edit the passwords below
#
# !!! USE ALPHANUMERIC PASSWORDS ONLY (A-Z a-z 0-9), long. Do NOT use $ # & ! % ) ] " ' \ or
# spaces. Reasons: docker-compose .env parsing mangles $/#/quotes, AND Nextcloud puts the REDIS
# password into a `tcp://…?auth=<pw>` URL where & ! % etc. corrupt it → "Redis connection not
# available" → you can't even log in. Make them random but plain (e.g. `openssl rand -hex 24`).

# ── Admin account created on first launch ───────────────────────────────────────
# NOTE: only applied on the FIRST install. To change it later: occ user:resetpassword.
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=CHANGE_ME_alphanumeric_admin_password

# ── Internal service credentials — ALPHANUMERIC ONLY (see warning above) ────────
NEXTCLOUD_DB_PASSWORD=CHANGE_ME_alphanumeric_db_password
# Redis has NO password (cache-only, on an internal non-exposed docker network) — nothing to set.

# ── Access (LAN/VPN only) ───────────────────────────────────────────────────────
# Host port on the NAS. The container listens on ALL interfaces, so it is reachable at BOTH:
#   http://192.168.1.18:<port>   (mgmt LAN / WireGuard)
#   http://10.10.10.13:<port>    (10 GbE isolated link — use THIS from the 10G-connected box for
#                                 max transfer speed; that segment only reaches the directly-wired
#                                 host, e.g. the W11 box at 10.10.10.11)
NEXTCLOUD_PORT=8888
# Hostnames/IPs allowed to serve the UI (space-separated). MUST include every address you browse
# to. `nas.negri.es` resolves to 10.10.10.13 (the 10 GbE link) in your DNS, so it's the fast-access
# name from the 10G-wired box; 192.168.1.18 is for the mgmt LAN / WireGuard. Do NOT set
# overwritehost, so any of these keeps working.
NEXTCLOUD_TRUSTED_DOMAINS=192.168.1.18 10.10.10.13 nas.negri.es cloud.negri.es
# Protocol. LEAVE EMPTY (recommended) → auto-detect: http on direct 10G/LAN access, https when it
# comes through the reverse proxy (as long as NEXTCLOUD_TRUSTED_PROXIES is set). This lets both the
# fast direct-http path AND an https-via-proxy path work at once.
#   - Only set `https` if you access ONLY through the proxy (never the raw :8080).
NEXTCLOUD_OVERWRITEPROTOCOL=
# If you front Nextcloud with a reverse proxy (NPM), set this to the proxy's IP/CIDR so Nextcloud
# trusts its X-Forwarded-* headers. NOTE: NPM runs on the hub (192.168.1.7) and CANNOT reach the
# isolated 10G net, so the proxy path uses the mgmt LAN (1G) — the 10G speed is only via DIRECT
# http to nas.negri.es. Leave empty if you never use the proxy.
#NEXTCLOUD_TRUSTED_PROXIES=192.168.1.7
# Base URL Nextcloud uses for cron/CLI-generated links; set to your proxied https URL if you use one.
#NEXTCLOUD_OVERWRITECLIURL=https://cloud.negri.es

# ── External storage (share the SAME files over SMB + Nextcloud) ────────────────
# Host path of a DEDICATED ZFS dataset (NOT the Nextcloud data dir!) bind-mounted into the
# container at /external/negri-data. Share this same dataset over SMB in TrueNAS, and add it in
# Nextcloud → Settings → External storage → Local, folder /external/negri-data. The dataset ACL
# must grant rwx to BOTH www-data (UID 33, the in-container user) and your SMB user.
NEXTCLOUD_EXTERNAL_HOST_PATH=/mnt/tank/negri-data

# ── Logs → Loki (for the "Nextcloud Logs" Grafana dashboard) ────────────────────
# The bundled Alloy tails data/nextcloud.log and pushes it to the hub's Loki (published on :3100).
# Default points at the hub over the mgmt LAN; change only if Loki moves.
NEXTCLOUD_LOKI_URL=http://192.168.1.7:3100/loki/api/v1/push
