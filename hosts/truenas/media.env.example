# Settings for the TrueNAS media stack (hosts/truenas/media.compose.yml).
# Copy to media.env (gitignored via `hosts/**/*.env`) and fill in. The truenas_media role syncs the
# real file to the NAS as `.env` next to the compose, where docker compose auto-reads it.
#
#   cp hosts/truenas/media.env.example hosts/truenas/media.env
#   # then set PUID/PGID/TZ below
#
# LAN/VPN only — no public exposure, so no secrets here (the apps set their own passwords in-UI).

# ── User the containers run as (LinuxServer.io PUID/PGID) ─────────────────────────
# MUST own the media dataset, or the apps can't write. Get them on the NAS with `id <user>`
# (e.g. `id truenas_admin`, or a dedicated `apps` user). The role chowns the /data subdirs to these.
PUID=1000
PGID=1000
TZ=Europe/Madrid

# ── Storage ───────────────────────────────────────────────────────────────────────
# Host path of the single media dataset, mounted as /data in every media-touching container.
# Downloads (/data/torrents) and libraries (/data/media/{movies,tv}) share this ONE filesystem so
# Sonarr/Radarr import by HARDLINK instead of copying. Must match truenas_media_library_dataset.
MEDIA_LIBRARY_HOST_PATH=/mnt/tank/media

# ── Host ports (reachable at 192.168.1.18:<port> over LAN/WireGuard) ──────────────
JELLYFIN_PORT=8096
SONARR_PORT=8989
RADARR_PORT=7878
BAZARR_PORT=6767
JACKETT_PORT=9117
# qBittorrent WebUI — 8085 by default to avoid clashing with Nextcloud (8080) on this same NAS.
# Published on the gluetun container (qBittorrent shares its network namespace).
QBITTORRENT_PORT=8085
# BitTorrent listen port. Set this to the port you RESERVED in AirVPN (client area → Ports) so
# inbound peers reach you; then set the same value as qBittorrent's incoming-connections port.
QBITTORRENT_BT_PORT=6881
JELLYSEERR_PORT=5055
CANTINARR_PORT=8585

# ── VPN for torrents (gluetun + AirVPN, WireGuard) ─────────────────────────────────
# qBittorrent routes ALL traffic through gluetun with a kill-switch. Get these from AirVPN's
# Config Generator (https://airvpn.org → Client Area → Config Generator → WireGuard): download a
# config and copy PrivateKey, PresharedKey and the Address line. AirVPN needs the PRESHARED key too.
WIREGUARD_PRIVATE_KEY=
WIREGUARD_PRESHARED_KEY=
WIREGUARD_ADDRESSES=
# Exit-server selection: a country (gluetun picks a server) or pin exact AirVPN server name(s).
# For VPN AUTOSWITCH (below) to rotate ACROSS countries, list SEVERAL here — gluetun picks randomly
# from this pool on each (re)connect. Keep it to low-latency, well-provisioned countries.
VPN_SERVER_COUNTRIES=Netherlands,Germany,Switzerland,Belgium,Luxembourg,France,Sweden
VPN_SERVER_NAMES=
# Fixed WireGuard MTU. The path here blocks ICMP so gluetun's auto Path-MTU-Discovery fails and it
# flapped the tunnel in a loop (torrents stalled). Pinning it fixes that. 1320 = what PMTUD found;
# lower to 1280 if it still restarts. HEALTH duration gives the tunnel more time before a restart.
VPN_WIREGUARD_MTU=1320
VPN_HEALTH_DURATION_INITIAL=30s
# LAN/VPN subnet allowed to reach the qBittorrent WebUI through gluetun's kill-switch firewall.
# MUST include the hub that runs homepage (192.168.1.7).
VPN_LAN_SUBNET=192.168.1.0/24

# ── VPN auto-switch (vpn-autoswitch sidecar) ───────────────────────────────────────
# When qBittorrent stays slow, rotate gluetun onto a LESS-CONGESTED AirVPN COUNTRY. gluetun can only
# stop/start (it re-picks a server RANDOMLY from VPN_SERVER_COUNTRIES above), so the sidecar restarts
# the tunnel and keeps trying until the exit country's least-loaded server (per airvpn.org/api/status)
# is at/under VPN_AUTOSWITCH_MAX_LOAD. NEEDS VPN_SERVER_COUNTRIES to list several countries.
# NOTE: only helps if the bottleneck is the AirVPN exit server — if it's your ISP at peak, switching
# won't change anything. Each switch drops the tunnel ~10-30s (torrents pause briefly).
VPN_AUTOSWITCH_ENABLED=false
# Trigger: download rate below this many MB/s, sustained for this many minutes, with seeded torrents.
VPN_AUTOSWITCH_SLOW_MBPS=1
VPN_AUTOSWITCH_SLOW_MINUTES=10
# A landing country counts as "decongested" when its best healthy server's load % is at/under this.
VPN_AUTOSWITCH_MAX_LOAD=70
# Max tunnel restarts per switch attempt before giving up until the next cycle.
VPN_AUTOSWITCH_MAX_ATTEMPTS=6
# Minutes to wait after a switch before switching again (anti-flap).
VPN_AUTOSWITCH_COOLDOWN=20
# How often (seconds) to sample qBittorrent's speed.
VPN_AUTOSWITCH_POLL=60
# Optional: restrict acceptable landing countries (comma list, AirVPN names). Blank = any in the pool.
VPN_AUTOSWITCH_ALLOWED_COUNTRIES=
# Override only if AirVPN moves the endpoint (default is fine).
VPN_AUTOSWITCH_STATUS_URL=https://airvpn.org/api/status/

# ── Cantinarr ─────────────────────────────────────────────────────────────────────
# Hosted push-notification gateway (project default). Leave blank to disable push notifications.
CANTINARR_PUSH_GATEWAY_URL=https://push.cantinarr.com

# ── Observability ───────────────────────────────────────────────────────────────────
# Where media-alloy pushes the container logs — the hub's Loki, published on :3100. Default points
# at the rpi5 hub; change only if the hub moves. See the "Observability" section of README.md.
MEDIA_LOKI_URL=http://192.168.1.7:3100/loki/api/v1/push
# API keys for the *arr exporters (exportarr). Leave these BLANK — the truenas_media role reads them
# from each app's config after first boot and writes them here automatically (same discovery it uses
# for the homepage widgets). Setting them by hand is neither needed nor recommended.
SONARR_KEY=
RADARR_KEY=
BAZARR_KEY=
# qBittorrent WebUI credentials for its exporter. Leave BLANK: the role whitelists the Docker bridge
# subnet in qBittorrent so the exporter connects without auth. Only fill these if you disabled the
# whitelist and the exporter can't reach the WebUI.
QBITTORRENT_USER=
QBITTORRENT_PASSWORD=
