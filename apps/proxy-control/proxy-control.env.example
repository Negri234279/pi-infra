# Secretos de proxy-control en PROD. Copia a proxy-control.env (gitignored) SOLO en la Pi.
# El runtime usa PgBouncer; las migraciones van directas a Postgres.

# Base de datos (password ALFANUMÉRICA; debe coincidir con la de postgres/provision.env)
#  runtime    → pgbouncer:6432 (transaction mode)
#  migraciones→ postgres:5432 (directo)
DATABASE_URL=postgresql://proxy_control:__STRONG_PASSWORD__@pgbouncer:6432/proxy_control
MIGRATION_DATABASE_URL=postgresql://proxy_control:__STRONG_PASSWORD__@postgres:5432/proxy_control

# Nginx Proxy Manager (el del core)
NPM_BASE_URL=http://nginx-proxy-manager:81
NPM_EMAIL=admin@example.com
NPM_PASSWORD=__set__

# ── Proveedores DNS (Cloudflare / Mikrotik) — LEGACY / opcional ──
# Se configuran desde el panel web (Ajustes → Proveedores DNS) y se guardan cifrados en la DB.
# Estas vars solo se usan, si están presentes, para el SEED inicial del primer arranque.
# Cloudflare es multizona: basta el token; CLOUDFLARE_ZONE_ID es solo la zona por defecto.
# CLOUDFLARE_API_TOKEN=__set__
# CLOUDFLARE_ZONE_ID=__set__
# PUBLIC_IP=203.0.113.10
# MIKROTIK_BASE_URL=https://192.168.88.1
# MIKROTIK_USER=proxy-control
# MIKROTIK_PASSWORD=__set__
# MIKROTIK_TLS_INSECURE=false
# NPM_INTERNAL_IP=192.168.1.10

# Auth del panel
AUTH_ENABLED=true
AUTH_USER=admin
AUTH_PASSWORD_HASH=__genera_con_npm_run_auth:hash__
SESSION_SECRET=__cadena_larga_y_aleatoria__

# Cifrado de los secretos de proveedores DNS en la DB (AES-256-GCM). OBLIGATORIA.
SETTINGS_KEY=__cadena_larga_y_aleatoria__

# ── Descubrimiento de dominios por labels de Docker (estilo Traefik) — opcional ──
# En prod la app NO monta el socket: habla con el daemon vía el servicio
# proxy-control-docker-proxy (API filtrada y read-only). Ese DOCKER_HOST ya está
# cableado en compose.yml; aquí basta con activar el descubrimiento.
# DOCKER_LABELS_ENABLED=true
# DOCKER_LABEL_PREFIX=proxy-control
# DOCKER_RESYNC_INTERVAL_MS=60000
# DOCKER_EVENT_DEBOUNCE_MS=500
#
# Multi-host: para vigilar VARIOS daemons, define DOCKER_HOSTS (tiene prioridad sobre el
# DOCKER_HOST de compose.yml). Lista `nombre=url` separada por comas; la url admite
# tcp://host:port, unix:///ruta.sock o una ruta de socket. Un docker-socket-proxy por host
# (ver ejemplo comentado en compose.yml). El nombre etiqueta métricas, estado y trazabilidad
# y NO se debe cambiar luego (los dominios recuerdan de qué host se descubrieron).
# DOCKER_HOSTS=local=tcp://proxy-control-docker-proxy:2375,pi2=tcp://proxy-control-docker-proxy-pi2:2375

# ── Descubrimiento de dominios por fichero YAML — opcional ──
# Para paneles que NO son contenedores (Proxmox, TrueNAS…). El directorio ./domains.d ya está
# montado en /config/domains.d por compose.yml; añade tus *.yaml ahí (versionados en el repo,
# se sincronizan a pi-infra). Aquí basta con activarlo:
# FILE_DOMAINS_ENABLED=true

# Alerting (opcional): webhook de Discord propio
PROXY_CONTROL_DISCORD_WEBHOOK_URL=
