# Declaración de la base de datos de proxy-control para el provisioner del Postgres
# COMPARTIDO (pi-infra core/postgres). Copia a provision.env (gitignored). El provisioner
# del core lee apps/proxy-control/postgres/provision.env en cada `up` y asegura de forma
# idempotente este rol + base de datos + grants.
#
# IMPORTANTE:
#  - Password ALFANUMÉRICA (se interpola en SQL — evita $ ` ' " y espacios).
#  - APP_DB_PASSWORD DEBE coincidir con la de DATABASE_URL y MIGRATION_DATABASE_URL en
#    proxy-control.env (única fuente de verdad).
APP_DB=proxy_control
APP_DB_USER=proxy_control
APP_DB_PASSWORD=__STRONG_PASSWORD__
