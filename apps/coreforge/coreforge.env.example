# PROD secrets/env for the coreforge stack. Copy to `coreforge.env` on the Pi
# (gitignored — the sync-pi-infra action never copies real *.env files) and
# fill in. Loaded via env_file by coreforge-app and coreforge-alertmanager-init.
#
# Sibling env examples in infra/{dev,staging}/ — never share secrets between
# environments.

# ── Alerting ─────────────────────────────────────────────────────────────
# Discord webhook for coreforge's OWN alert channel (Server Settings →
# Integrations → Webhooks). Written to a secret file by the alertmanager-init
# container. Leave empty to run Alertmanager without Discord delivery.
COREFORGE_DISCORD_WEBHOOK_URL=

# ── App ──────────────────────────────────────────────────────────────────
# Central pi-infra Grafana URL — renders the "Grafana" button on /admin.
# Unset to hide the button.
GRAFANA_URL=

# App secrets (session signing, Google OAuth, ...) go here too if the
# deployment uses them — anything the container expects as process.env.
