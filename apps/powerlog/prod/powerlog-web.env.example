JWT_PUBLIC_KEY=""

# ── Web ──────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="https://powerlog.negri.es."
NEXT_PUBLIC_GRAPHQL_URL="/api/graphql"
# Socket.IO (presence + live chat) connects DIRECTLY to the API — Next rewrites
# don't forward the WS Upgrade. Requires "Websockets Support" ON for the
# api.powerlog.negri.es proxy host in nginx-proxy-manager, plus
# `proxy_read_timeout 3600s;` in its Advanced config.
NEXT_PUBLIC_WS_URL="https://api.powerlog.negri.es"

JWT_ISSUER="powerlog"
JWT_AUDIENCE="powerlog-web"
JWT_EXPIRES_IN="15m"
REFRESH_EXPIRES_IN="30d"
AUTH_COOKIE_NAME="pl_at"
REFRESH_COOKIE_NAME="pl_rt"

WEB_ORIGIN="https://powerlog.negri.es"